{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: npm start",
      "type": "npm",
      "script": "start",
      "path": "frontend-ng/data-engine",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Application bundle generation failed|Building|Changes detected",
          "endsPattern": "Local:|Application bundle generation complete"
        }
      }
    },
    {
      "label": "frontend: npm test",
      "type": "npm",
      "script": "test",
      "path": "frontend-ng/data-engine",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Application bundle generation failed|Building|Changes detected",
          "endsPattern": "Local:|Application bundle generation complete"
        }
      }
    }
  ]
}
